# --- Bot (Pflicht) ---------------------------------------------------------
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=hier_den_bot_token_einfuegen

# Frei gewaehltes Geheimnis fuer die REST-API.
# Erzeugen z.B. mit:  openssl rand -hex 32
API_TOKEN=hier_ein_langes_zufaelliges_token

# --- Dashboard (Pflicht, sobald das Dashboard laufen soll) -----------------
# Aus dem Developer Portal -> OAuth2 -> Client ID / Client Secret
DISCORD_CLIENT_ID=hier_die_client_id
DISCORD_CLIENT_SECRET=hier_das_client_secret

# Verschluesselt die Login-Sitzungen. Eigener Wert, NICHT derselbe wie API_TOKEN.
# Erzeugen z.B. mit:  openssl rand -hex 32
AUTH_SECRET=hier_ein_weiteres_langes_zufaelliges_token

# Die Adresse, unter der du das Dashboard im Browser aufrufst.
# MUSS exakt mit der Redirect-URL im Developer Portal uebereinstimmen,
# sonst scheitert der Login mit "invalid redirect_uri".
# Beispiel fuer den Server im Heimnetz:
AUTH_URL=http://192.168.1.50:3000

# --- Optional: Zugriff von aussen mit HTTPS --------------------------------
# Token aus dem Cloudflare-Dashboard (Zero Trust -> Networks -> Tunnels).
# Nur noetig, wenn du den Tunnel nutzt - siehe docs/cloudflare-tunnel.md
# Starten dann mit:  docker compose --profile tunnel up -d
#CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional --------------------------------------------------------------
# Port, auf dem das Dashboard erreichbar ist
DASHBOARD_PORT=3000

# Port, auf dem die API lokal erreichbar ist (nur 127.0.0.1)
API_PORT=8080

# --- Betreiber -------------------------------------------------------------
# Deine Discord-User-ID (Rechtsklick auf dich selbst -> "Benutzer-ID kopieren";
# dafuer muss in den Discord-Einstellungen unter "Erweitert" der Entwicklermodus
# an sein). Mehrere durch Komma trennen.
#
# Wer hier steht, darf Sicherungen abrufen und herunterladen. Das ist bewusst
# getrennt von den Server-Admins: Eine Sicherung enthaelt die Daten ALLER
# Server, die diesen Bot nutzen.
OWNER_IDS=deine_discord_user_id

# --- Sicherung -------------------------------------------------------------
# Wann automatisch gesichert wird (Cron). Standard: taeglich um 4 Uhr.
# Leer setzen (BACKUP_CRON=) schaltet die automatische Sicherung ab.
BACKUP_CRON=0 4 * * *

# Wie lange Sicherungen aufbewahrt werden (eine je Tag)
BACKUP_KEEP_DAYS=14

# --- Optional --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# Wie oft die YouTube-Feeds geprueft werden (Millisekunden, Standard 10 Minuten).
# Zusaetzlich prueft der Bot bei jedem Start und auf Knopfdruck im Dashboard.
YOUTUBE_INTERVAL_MS=600000

# --- Hinweis: eigene Plugins ------------------------------------------------
# Eigene Erweiterungen kommen in den Ordner ./plugins - er ist in der
# docker-compose.yml bereits eingebunden, hier ist nichts einzutragen.
# Anleitung: docs/plugin-entwickeln.md
