# Zugangsdaten - niemals einchecken
.env
.env.local
.env.*.local

# Abhängigkeiten und Build-Ausgaben
node_modules/
.next/
.next-*/
.turbo/

# Fertige Image-Archive (über 100 MB)
dist/

# Datenbank und Sicherungen
data/
backups/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Eigene Plugins der jeweiligen Installation bleiben draussen. Was mitgeliefert
# wird - Anleitung, Beispiel und das Regeln-Plugin - gehoert aber ins Repo.
plugins/*
!plugins/README.md
!plugins/*.js.txt
!plugins/regeln/

# Betriebssystem
.DS_Store
Thumbs.db
