# Zugangsdaten - niemals einchecken
.env
.env.local
.env.*.local

# Abhängigkeiten und Build-Ausgaben
node_modules/
.next/
.next-*/
.turbo/

# Fertige Image-Archive (über 100 MB)
dist/

# Datenbank und Sicherungen
data/
backups/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Eigene Plugins der jeweiligen Installation bleiben draussen. Was mitgeliefert
# wird, gehoert aber ins Repo.
#
# ACHTUNG bei neuen mitgelieferten Plugins: Ohne eigene !-Zeile landen sie
# NICHT im Repo - und fehlen dann auf jedem Server, ohne dass es auffaellt.
# Genau das ist mit plugins/twitch/ passiert.
plugins/*
!plugins/README.md
!plugins/*.js.txt
!plugins/regeln/
!plugins/twitch/

# Betriebssystem
.DS_Store
Thumbs.db
